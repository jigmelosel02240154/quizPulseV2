PORT=3000
# Local development: path to the key downloaded from Firebase Console > Project settings > Service accounts
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Hosting (Render/Railway): paste the whole JSON key on ONE line instead of using the file above
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Bhutan is UTC+6. Used for the daily streak calendar.
TZ_OFFSET_HOURS=6
# false: college email format is enough to join a campus (demo/testing)
# true : the user must also verify the email (recommended for real use)
REQUIRE_VERIFIED_EMAIL=false
